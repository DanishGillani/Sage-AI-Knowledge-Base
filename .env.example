# =============================================================================
# Sage — Root environment variables (Next.js BFF)
# Copy to .env and fill in your values.
# See apps/api/.env.example for the FastAPI service variables.
# =============================================================================

# ── Database (Prisma — Next.js BFF) ──────────────────────────────────────────
# Plain postgres:// URL — no asyncpg driver prefix
POSTGRES_USER="sage"
POSTGRES_PASSWORD="sage"          # Change in production!
POSTGRES_DB="sage"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# ── FastAPI service ───────────────────────────────────────────────────────────
# URL of the FastAPI RAG service — must be reachable from the Next.js process
API_BASE_URL="http://localhost:8000"

# ── Internal auth ─────────────────────────────────────────────────────────────
# Shared secret added as x-internal-secret header on all BFF → FastAPI calls.
# Must match API_INTERNAL_SECRET in apps/api/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET="change-me-in-production"
