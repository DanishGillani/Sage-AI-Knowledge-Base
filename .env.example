# =============================================================================
# Sage — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://sage:sage@localhost:5432/sage"

# --- AI Provider ---
# Switch between "ollama" (free, local) and "openai" (paid, cloud)
AI_PROVIDER="ollama"

# --- Ollama (local, free) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_VISION_MODEL="qwen2.5-vl:7b"

# --- OpenAI (optional, swap AI_PROVIDER to "openai") ---
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBED_MODEL="text-embedding-3-small"

# --- FastAPI Service ---
API_BASE_URL="http://localhost:8000"
API_INTERNAL_SECRET="change-me-in-production"

# --- Next.js ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
