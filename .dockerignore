# Dependencies — let Docker install these fresh
**/node_modules
.pnpm-store

# Next.js build output
**/.next

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/htmlcov
**/.coverage

# Test artifacts
**/coverage
**/playwright/report
**/playwright/.cache
**/test-results

# Environment files — never bake secrets into images
**/.env
**/.env.*
!**/.env.example

# Misc
**/*.tsbuildinfo
**/.DS_Store
**/Thumbs.db
**/*.log
