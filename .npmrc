enable-pre-post-scripts=true

# Hoist all packages to root node_modules (like npm/yarn).
# Required for webpack/Next.js to reliably resolve workspace packages in Docker.
node-linker=hoisted

# Allow build scripts for native packages
approve-builds[]=@prisma/client
approve-builds[]=@prisma/engines
approve-builds[]=esbuild
approve-builds[]=msw
approve-builds[]=prisma
approve-builds[]=sharp
approve-builds[]=unrs-resolver
