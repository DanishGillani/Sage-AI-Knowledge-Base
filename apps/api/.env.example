# =============================================================================
# Sage — FastAPI service environment variables
# Copy to apps/api/.env and fill in your values.
# =============================================================================

# ── Database (SQLAlchemy asyncpg) ─────────────────────────────────────────────
# Must use the asyncpg:// driver prefix
DATABASE_URL="postgresql+asyncpg://sage:<your-postgres-password>@localhost:5432/sage"

# ── AI Provider ───────────────────────────────────────────────────────────────
# "ollama" = free, runs locally (default)
# "openai" = paid, cloud — switch with no code changes
AI_PROVIDER="ollama"

# ── Ollama (local, no API key needed) ─────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_VISION_MODEL="qwen2.5-vl:7b"

# ── OpenAI (optional — set AI_PROVIDER=openai to activate) ───────────────────
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBED_MODEL="text-embedding-3-small"

# ── RAG tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# ── Internal auth ─────────────────────────────────────────────────────────────
# Must match INTERNAL_SECRET in the root .env (used by the Next.js BFF)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_INTERNAL_SECRET=""            # Required — generate: openssl rand -hex 32

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:3000"]'
